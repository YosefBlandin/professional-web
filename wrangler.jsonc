{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "professional-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "professional-web"
    }
  ],
  // Serve the site on the custom domain; the middleware redirects www to the apex.
  "routes": [
    { "pattern": "yosefblandin.com", "custom_domain": true },
    { "pattern": "www.yosefblandin.com", "custom_domain": true }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Required by `wrangler preview` (Workers Builds runs it on non-production branches).
  "previews": {}
}
